---
import { Font } from 'astro:assets';
import Parser from 'rss-parser';
import '../styles/global.css';
import { GA_ID } from 'astro:env/server';

const parser = new Parser();

const rssResults = await Promise.all([
  parser.parseURL('https://brunch.co.kr/rss/@@7vHu'),
  parser.parseURL('https://medium.com/feed/@oddmj'),
]);

const feeds = rssResults
  .flatMap((feed) => feed.items)
  .sort((a, b) => {
    if (!a.pubDate) {
      console.error('pubDate does not exist', a);
      throw new Error('pubDate does not exist');
    }

    if (!b.pubDate) {
      console.error('pubDate does not exist', b);
      throw new Error('pubDate does not exist');
    }

    return new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime();
  });
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>odd.voyage</title>
    <Font cssVariable="--font-sorts-mill-goudy" preload />
    <Font cssVariable="--font-pretendard" preload />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
    ></script>
    <script is:inline define:vars={{ gaId: GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', gaId);
    </script>
  </head>
  <body>
    <div class="mx-auto max-w-md">
      <header class="flex justify-center py-1">
        <span class="font-(family-name:--font-sorts-mill-goudy) text-lg"
          >odd.voyage</span
        >
      </header>
      <main class="px-4 font-(family-name:--font-pretendard)">
        <span>글</span>
        <ul class="list-inside list-disc">
          {
            feeds.map((item) => (
              <li>
                <a href={item.link}>{item.title}</a>
              </li>
            ))
          }
        </ul>
        <span>링크</span>
        <ul class="list-inside list-disc">
          <li>
            <a href="https://public.odd.voyage">second brain</a>
          </li>
          <li>
            <a href="https://github.com/oddmj">github</a>
          </li>
        </ul>
      </main>
    </div>
  </body>
</html>
